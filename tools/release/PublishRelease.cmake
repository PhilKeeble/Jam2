cmake_minimum_required(VERSION 3.24)
if(NOT EXISTS "${JAM2_PACKAGE_CONFIG}")
    message(FATAL_ERROR "A completed release package configuration is required")
endif()
include("${JAM2_PACKAGE_CONFIG}")
if(NOT JAM2_PACKAGE_PLATFORM MATCHES "^(windows|macos)$")
    message(FATAL_ERROR "Unsupported publication platform")
endif()
if(NOT DEFINED JAM2_PACKAGE_OUTPUT)
    set(JAM2_PACKAGE_OUTPUT "${JAM2_PACKAGE_SOURCE}/dist")
endif()
file(REAL_PATH "${JAM2_PACKAGE_SOURCE}" JAM2_PACKAGE_SOURCE)
file(REAL_PATH "${JAM2_PACKAGE_OUTPUT}" JAM2_PACKAGE_OUTPUT)
cmake_path(IS_PREFIX JAM2_PACKAGE_SOURCE "${JAM2_PACKAGE_OUTPUT}" NORMALIZE confined)
if(NOT confined OR JAM2_PACKAGE_OUTPUT STREQUAL JAM2_PACKAGE_SOURCE)
    message(FATAL_ERROR "Publication inputs must stay inside the repository")
endif()
file(LOCK "${JAM2_PACKAGE_OUTPUT}/.package.lock" GUARD PROCESS TIMEOUT 0)
find_program(JAM2_GH_EXECUTABLE NAMES gh REQUIRED)
set(repository github.com/PhilKeeble/Jam2)
set(api_repository repos/PhilKeeble/Jam2)

function(gh output)
    execute_process(COMMAND "${JAM2_GH_EXECUTABLE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE body ERROR_VARIABLE error TIMEOUT 1800)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "GitHub command failed (${result}): ${error}")
    endif()
    set(${output} "${body}" PARENT_SCOPE)
endfunction()

function(releases output)
    gh(pages api "${api_repository}/releases" --hostname github.com --paginate --slurp
        -H "Cache-Control: no-cache")
    string(JSON page_count LENGTH "${pages}")
    set(all "[]")
    set(count 0)
    if(page_count GREATER 0)
        math(EXPR last_page "${page_count} - 1")
        foreach(page RANGE 0 ${last_page})
            string(JSON items LENGTH "${pages}" ${page})
            if(items GREATER 0)
                math(EXPR last_item "${items} - 1")
                foreach(item RANGE 0 ${last_item})
                    string(JSON release GET "${pages}" ${page} ${item})
                    string(JSON all SET "${all}" ${count} "${release}")
                    math(EXPR count "${count} + 1")
                endforeach()
            endif()
        endforeach()
    endif()
    set(${output} "${all}" PARENT_SCOPE)
endfunction()

function(find_release all tag output)
    string(JSON count LENGTH "${all}")
    set(found "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON candidate GET "${all}" ${index} tag_name)
            if(candidate STREQUAL tag)
                string(JSON found GET "${all}" ${index})
                break()
            endif()
        endforeach()
    endif()
    set(${output} "${found}" PARENT_SCOPE)
endfunction()

function(find_asset release name output)
    string(JSON count LENGTH "${release}" assets)
    set(found "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON candidate GET "${release}" assets ${index} name)
            if(candidate STREQUAL name)
                string(JSON found GET "${release}" assets ${index})
                break()
            endif()
        endforeach()
    endif()
    set(${output} "${found}" PARENT_SCOPE)
endfunction()

function(asset_ready release name output)
    find_asset("${release}" "${name}" asset)
    set(ready FALSE)
    if(asset)
        string(JSON state GET "${asset}" state)
        string(JSON size GET "${asset}" size)
        string(JSON digest ERROR_VARIABLE error GET "${asset}" digest)
        string(LENGTH "${digest}" digest_length)
        if(state STREQUAL "uploaded" AND size GREATER 0 AND error STREQUAL "NOTFOUND"
                AND digest MATCHES "^sha256:[0-9a-f]+$" AND digest_length EQUAL 71)
            set(ready TRUE)
        endif()
    endif()
    set(${output} "${ready}" PARENT_SCOPE)
endfunction()

function(remote_json release name output)
    find_asset("${release}" "${name}" asset)
    string(JSON size GET "${asset}" size)
    if(size GREATER 65536)
        message(FATAL_ERROR "Release metadata is too large: ${name}")
    endif()
    string(JSON id GET "${asset}" id)
    set(download "${JAM2_PACKAGE_OUTPUT}/.metadata-${id}.json")
    if(IS_SYMLINK "${download}")
        message(FATAL_ERROR "Metadata download destination must not be a symlink: ${download}")
    endif()
    # OUTPUT_VARIABLE normalizes CRLF on Windows. Hash the downloaded bytes
    # before reading them as text so GitHub's digest remains meaningful.
    execute_process(COMMAND "${JAM2_GH_EXECUTABLE}" api
        "${api_repository}/releases/assets/${id}" --hostname github.com
        -H "Accept: application/octet-stream" -H "Cache-Control: no-cache"
        RESULT_VARIABLE result OUTPUT_FILE "${download}" ERROR_VARIABLE error TIMEOUT 120)
    if(NOT result EQUAL 0)
        file(REMOVE "${download}")
        message(FATAL_ERROR "Could not download release metadata ${name} (${result}): ${error}")
    endif()
    string(JSON digest GET "${asset}" digest)
    file(SIZE "${download}" actual_size)
    file(SHA256 "${download}" hash)
    if(NOT actual_size EQUAL size OR NOT digest STREQUAL "sha256:${hash}")
        file(REMOVE "${download}")
        message(FATAL_ERROR "Downloaded metadata digest mismatch: ${name}")
    endif()
    file(READ "${download}" body)
    file(REMOVE "${download}")
    set(${output} "${body}" PARENT_SCOPE)
    set(${output}_sha256 "${hash}" PARENT_SCOPE)
endfunction()

function(metadata_matches release name metadata output)
    find_asset("${release}" "${name}" asset)
    string(JSON expected_name ERROR_VARIABLE name_error GET "${metadata}" asset)
    string(JSON expected_size ERROR_VARIABLE size_error GET "${metadata}" bytes)
    string(JSON expected_hash ERROR_VARIABLE hash_error GET "${metadata}" sha256)
    string(JSON actual_size GET "${asset}" size)
    string(JSON actual_digest GET "${asset}" digest)
    set(matches FALSE)
    if(name_error STREQUAL "NOTFOUND" AND size_error STREQUAL "NOTFOUND" AND
            hash_error STREQUAL "NOTFOUND" AND expected_name STREQUAL name AND
            actual_size EQUAL expected_size AND actual_digest STREQUAL "sha256:${expected_hash}")
        set(matches TRUE)
    endif()
    set(${output} "${matches}" PARENT_SCOPE)
endfunction()

function(model_ready all tag expected_manifest output)
    if(DEFINED uploaded_model_release_id AND tag STREQUAL model_tag)
        # A just-published model release may not have reached the list endpoint.
        gh(release api "${api_repository}/releases/${uploaded_model_release_id}"
            --hostname github.com -H "Cache-Control: no-cache")
    else()
        find_release("${all}" "${tag}" release)
        if(release)
            string(JSON id GET "${release}" id)
            gh(release api "${api_repository}/releases/${id}"
                --hostname github.com -H "Cache-Control: no-cache")
        endif()
    endif()
    set(ready FALSE)
    if(release)
        string(JSON draft GET "${release}" draft)
        asset_ready("${release}" Jam2-models.zip zip_ready)
        asset_ready("${release}" Jam2-models.zip.json metadata_ready)
        asset_ready("${release}" models.json manifest_ready)
        if(NOT draft AND zip_ready AND metadata_ready AND manifest_ready)
            remote_json("${release}" Jam2-models.zip.json metadata)
            metadata_matches("${release}" Jam2-models.zip "${metadata}" matches)
            string(JSON metadata_tag ERROR_VARIABLE error GET "${metadata}" tag)
            remote_json("${release}" models.json manifest)
            string(JSON manifest_tag ERROR_VARIABLE manifest_error GET "${manifest}" tag)
            if(matches AND error STREQUAL "NOTFOUND" AND metadata_tag STREQUAL tag AND
                    manifest_error STREQUAL "NOTFOUND" AND manifest_tag STREQUAL tag AND
                    manifest_sha256 STREQUAL expected_manifest)
                set(ready TRUE)
            endif()
        endif()
    endif()
    set(${output} "${ready}" PARENT_SCOPE)
endfunction()

function(mutable release)
    string(JSON immutable ERROR_VARIABLE error GET "${release}" immutable)
    if(error STREQUAL "NOTFOUND" AND immutable)
        message(FATAL_ERROR "This GitHub release is immutable and cannot accept --clobber uploads. Use a new mutable release/version.")
    endif()
endfunction()

function(ensure_release tag title output)
    releases(all)
    find_release("${all}" "${tag}" release)
    if(NOT release)
        # Application tags may target local HEAD. Model releases use GitHub's
        # default branch; their identity comes from model contents, not commits.
        # Existing tags are never moved and no commit equality gate is imposed.
        set(target "")
        if(tag MATCHES "^v[0-9]")
            find_program(git NAMES git)
            if(git)
                execute_process(COMMAND "${git}" -C "${JAM2_PACKAGE_SOURCE}" rev-parse HEAD
                    RESULT_VARIABLE git_result OUTPUT_VARIABLE revision ERROR_QUIET
                    OUTPUT_STRIP_TRAILING_WHITESPACE)
                if(git_result EQUAL 0 AND revision MATCHES "^[0-9a-f]+$")
                    set(target --raw-field "target_commitish=${revision}")
                endif()
            endif()
        endif()
        # Keep the release object returned by creation. Immediately re-listing
        # releases can return an older list that does not contain the new draft.
        execute_process(COMMAND "${JAM2_GH_EXECUTABLE}" api "${api_repository}/releases"
            --hostname github.com --method POST --raw-field "tag_name=${tag}"
            --raw-field "name=${title}" --raw-field "body=Created by Jam2 build-release."
            --field draft=true --raw-field make_latest=false
            ${target} RESULT_VARIABLE result ERROR_VARIABLE error OUTPUT_VARIABLE body TIMEOUT 120)
        if(result EQUAL 0)
            string(JSON created_tag ERROR_VARIABLE parse_error GET "${body}" tag_name)
            if(NOT parse_error STREQUAL "NOTFOUND" OR NOT created_tag STREQUAL tag)
                message(FATAL_ERROR "GitHub created a release but returned an unexpected release object for ${tag}")
            endif()
            set(release "${body}")
        else()
            # Another platform may have won the creation race. Give the list a
            # short, bounded opportunity to expose that draft before failing.
            foreach(attempt RANGE 1 3)
                releases(all)
                find_release("${all}" "${tag}" release)
                if(release)
                    break()
                endif()
                if(attempt LESS 3)
                    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
                endif()
            endforeach()
            if(NOT release)
                message(FATAL_ERROR "Could not create release ${tag} (${result}): ${error}")
            endif()
        endif()
    endif()
    set(${output} "${release}" PARENT_SCOPE)
endfunction()

function(local_asset name tag channel output)
    set(path "${JAM2_PACKAGE_OUTPUT}/${name}")
    if(NOT EXISTS "${path}" OR NOT EXISTS "${path}.json")
        message(FATAL_ERROR "Missing local release archive or metadata: ${name}")
    endif()
    file(READ "${path}.json" metadata)
    string(JSON actual_tag GET "${metadata}" tag)
    string(JSON actual_name GET "${metadata}" asset)
    string(JSON actual_channel GET "${metadata}" channel)
    string(JSON expected_size GET "${metadata}" bytes)
    string(JSON expected_hash GET "${metadata}" sha256)
    file(SIZE "${path}" size)
    file(SHA256 "${path}" hash)
    if(NOT actual_tag STREQUAL tag OR NOT actual_name STREQUAL name OR NOT actual_channel STREQUAL channel
            OR NOT size EQUAL expected_size OR NOT hash STREQUAL expected_hash)
        message(FATAL_ERROR "Local release metadata does not match its archive: ${name}")
    endif()
    set(${output} "${metadata}" PARENT_SCOPE)
endfunction()

set(app_tag "v${JAM2_PACKAGE_VERSION}")
set(app_asset "Jam2-${JAM2_PACKAGE_PLATFORM}.zip")
local_asset("${app_asset}" "${app_tag}" stable app_metadata)
string(JSON model_tag GET "${app_metadata}" models_tag)
string(JSON expected_model_manifest GET "${app_metadata}" models_manifest_sha256)
string(LENGTH "${model_tag}" tag_length)
if(NOT model_tag MATCHES "^models-[0-9a-f]+$" OR NOT tag_length EQUAL 23)
    message(FATAL_ERROR "Invalid required model release tag")
endif()
gh(auth auth status --hostname github.com)

if(JAM2_INCLUDE_MODELS)
    local_asset(Jam2-models.zip "${model_tag}" models model_metadata)
    set(model_manifest "${JAM2_PACKAGE_RELEASE}/models.json")
    file(SHA256 "${model_manifest}" actual_manifest)
    if(NOT actual_manifest STREQUAL expected_model_manifest)
        message(FATAL_ERROR "The local model manifest does not match the application package")
    endif()
    ensure_release("${model_tag}" "JamTaster Models" release)
    string(JSON uploaded_model_release_id GET "${release}" id)
    model_ready("[]" "${model_tag}" "${expected_model_manifest}" models_already_uploaded)
    if(models_already_uploaded)
        message(STATUS "Reusing published model release ${model_tag}; no model upload needed")
    else()
        mutable("${release}")
        message(STATUS "Uploading model assets to ${model_tag} with --clobber")
        gh(upload release upload "${model_tag}" --repo "${repository}" --clobber
            "${JAM2_PACKAGE_OUTPUT}/Jam2-models.zip" "${JAM2_PACKAGE_OUTPUT}/Jam2-models.zip.json"
            "${model_manifest}")
        gh(publish release edit "${model_tag}" --repo "${repository}" --draft=false --latest=false
            --title "JamTaster Models")
    endif()
endif()

ensure_release("${app_tag}" "Jam2 ${JAM2_PACKAGE_VERSION}" release)
mutable("${release}")
string(JSON app_release_id GET "${release}" id)
string(JSON draft GET "${release}" draft)
releases(all)
model_ready("${all}" "${model_tag}" "${expected_model_manifest}" local_models_ready)
if(NOT draft AND NOT local_models_ready)
    message(FATAL_ERROR "The required model release is unavailable. Use --include-models before replacing assets in this published release.")
endif()
message(STATUS "Uploading ${app_asset} to ${app_tag} with --clobber")
gh(upload release upload "${app_tag}" --repo "${repository}" --clobber
    "${JAM2_PACKAGE_OUTPUT}/${app_asset}" "${JAM2_PACKAGE_OUTPUT}/${app_asset}.json")
releases(all)
gh(release api "${api_repository}/releases/${app_release_id}" --hostname github.com
    -H "Cache-Control: no-cache")
set(waiting "")
foreach(platform IN ITEMS windows macos)
    set(asset "Jam2-${platform}.zip")
    asset_ready("${release}" "${asset}" zip_ready)
    asset_ready("${release}" "${asset}.json" metadata_ready)
    if(NOT zip_ready OR NOT metadata_ready)
        list(APPEND waiting "${asset} and verified metadata")
        continue()
    endif()
    remote_json("${release}" "${asset}.json" metadata)
    metadata_matches("${release}" "${asset}" "${metadata}" matches)
    string(JSON version ERROR_VARIABLE version_error GET "${metadata}" version)
    string(JSON tag ERROR_VARIABLE tag_error GET "${metadata}" tag)
    string(JSON channel ERROR_VARIABLE channel_error GET "${metadata}" channel)
    string(JSON models ERROR_VARIABLE models_error GET "${metadata}" models_tag)
    string(JSON manifest ERROR_VARIABLE manifest_error GET "${metadata}" models_manifest_sha256)
    if(NOT matches OR NOT version_error STREQUAL "NOTFOUND" OR NOT tag_error STREQUAL "NOTFOUND"
            OR NOT channel_error STREQUAL "NOTFOUND" OR NOT models_error STREQUAL "NOTFOUND"
            OR NOT manifest_error STREQUAL "NOTFOUND" OR NOT version STREQUAL JAM2_PACKAGE_VERSION
            OR NOT tag STREQUAL app_tag OR NOT channel STREQUAL "stable")
        list(APPEND waiting "matching ${platform} metadata")
        continue()
    endif()
    model_ready("${all}" "${models}" "${manifest}" ready)
    if(NOT ready)
        list(APPEND waiting "model release ${models} required by ${platform}")
    endif()
endforeach()
if(waiting)
    list(JOIN waiting ", " waiting)
    message(STATUS "Assets uploaded; waiting for ${waiting}. No publication or old-release cleanup was performed.")
    return()
endif()

gh(publish release edit "${app_tag}" --repo "${repository}" --draft=false --latest=true)
message(STATUS "Published stable release ${app_tag}")
releases(all)
string(JSON count LENGTH "${all}")
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON previous GET "${all}" ${index})
        string(JSON tag GET "${previous}" tag_name)
        string(JSON draft GET "${previous}" draft)
        string(JSON prerelease GET "${previous}" prerelease)
        find_asset("${previous}" Jam2-windows.zip windows)
        find_asset("${previous}" Jam2-macos.zip macos)
        if(NOT tag STREQUAL app_tag AND NOT draft AND NOT prerelease AND (windows OR macos)
                AND tag MATCHES "^[vV]?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
            message(STATUS "Removing previous stable application release ${tag} and its assets (Git tag retained)")
            execute_process(COMMAND "${JAM2_GH_EXECUTABLE}" release delete "${tag}"
                --repo "${repository}" --yes RESULT_VARIABLE result
                OUTPUT_VARIABLE body ERROR_VARIABLE error TIMEOUT 120)
            if(NOT result EQUAL 0)
                # The other platform may have completed the same cleanup.
                releases(refreshed)
                find_release("${refreshed}" "${tag}" remaining)
                if(remaining)
                    message(FATAL_ERROR "Published ${app_tag}, but could not remove ${tag}: ${error}")
                endif()
            endif()
        endif()
    endforeach()
endif()
message(STATUS "Release: https://github.com/PhilKeeble/Jam2/releases/tag/${app_tag}")
