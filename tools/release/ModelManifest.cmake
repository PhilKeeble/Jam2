# Shared by normal builds and release packaging; model pins must be identical.
function(jam2_write_model_manifest source names destination)
    set(entries "")
    set(total 0)
    foreach(model IN LISTS names)
        if(NOT model MATCHES "^[a-z0-9_]+\\.onnx$")
            message(FATAL_ERROR "Invalid model filename: ${model}")
        endif()
        file(READ "${source}/app/jamtaster/models/${model}.json" sidecar)
        string(JSON declared GET "${sidecar}" model)
        string(JSON bytes GET "${sidecar}" bytes)
        string(JSON hash GET "${sidecar}" sha256)
        string(LENGTH "${hash}" hash_length)
        if(NOT declared STREQUAL model OR NOT bytes MATCHES "^[1-9][0-9]*$" OR
                NOT hash MATCHES "^[0-9a-f]+$" OR NOT hash_length EQUAL 64)
            message(FATAL_ERROR "Invalid model metadata: ${model}.json")
        endif()
        if(entries)
            string(APPEND entries ",\n")
        endif()
        string(APPEND entries "    {\"path\":\"${model}\",\"bytes\":${bytes},\"sha256\":\"${hash}\"}")
        math(EXPR total "${total} + ${bytes}")
    endforeach()
    string(SHA256 identity "${entries}")
    string(SUBSTRING "${identity}" 0 16 identity)
    set(tag "models-${identity}")
    set(url "https://github.com/PhilKeeble/Jam2/releases/download/${tag}/Jam2-models.zip")
    if(IS_SYMLINK "${destination}" OR IS_SYMLINK "${destination}.partial")
        message(FATAL_ERROR "Model manifest destination must not be a symlink")
    endif()
    set(contents "{\n  \"schema\":1,\n  \"tag\":\"${tag}\",\n  \"asset\":\"Jam2-models.zip\",\n  \"archive_root\":\"models/\",\n  \"url\":\"${url}\",\n  \"unpacked_bytes\":${total},\n  \"files\":[\n${entries}\n  ]\n}\n")
    file(CONFIGURE OUTPUT "${destination}.partial" CONTENT "${contents}" @ONLY NEWLINE_STYLE CRLF)
    file(RENAME "${destination}.partial" "${destination}")
    file(SHA256 "${destination}" manifest_hash)
    set(model_tag "${tag}" PARENT_SCOPE)
    set(model_manifest_hash "${manifest_hash}" PARENT_SCOPE)
endfunction()
