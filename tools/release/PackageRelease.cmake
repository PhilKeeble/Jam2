cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED JAM2_PACKAGE_CONFIG OR NOT EXISTS "${JAM2_PACKAGE_CONFIG}")
    message(FATAL_ERROR "Run build-release.ps1 or build-release.sh after a successful build")
endif()
include("${JAM2_PACKAGE_CONFIG}")
file(REAL_PATH "${JAM2_PACKAGE_SOURCE}" JAM2_PACKAGE_SOURCE)
file(REAL_PATH "${JAM2_PACKAGE_RELEASE}" JAM2_PACKAGE_RELEASE)
if(NOT DEFINED JAM2_PACKAGE_OUTPUT)
    set(JAM2_PACKAGE_OUTPUT "${JAM2_PACKAGE_SOURCE}/dist")
endif()
get_filename_component(JAM2_PACKAGE_OUTPUT "${JAM2_PACKAGE_OUTPUT}" ABSOLUTE)
file(REAL_PATH "${JAM2_PACKAGE_OUTPUT}" JAM2_PACKAGE_OUTPUT)
foreach(directory IN ITEMS "${JAM2_PACKAGE_RELEASE}" "${JAM2_PACKAGE_OUTPUT}")
    cmake_path(IS_PREFIX JAM2_PACKAGE_SOURCE "${directory}" NORMALIZE confined)
    if(NOT confined OR directory STREQUAL JAM2_PACKAGE_SOURCE)
        message(FATAL_ERROR "Release and output directories must remain inside the repository: ${directory}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${JAM2_PACKAGE_OUTPUT}")
file(LOCK "${JAM2_PACKAGE_OUTPUT}/.package.lock" GUARD PROCESS TIMEOUT 0)

function(write_json path contents)
    if(IS_SYMLINK "${path}" OR IS_SYMLINK "${path}.partial")
        message(FATAL_ERROR "Refusing a symlink at generated metadata: ${path}")
    endif()
    # Keep metadata byte-identical across Windows and macOS. Retain CRLF to
    # match existing Windows model manifests and allow their ZIPs to be reused.
    file(CONFIGURE OUTPUT "${path}.partial" CONTENT "${contents}\n" @ONLY NEWLINE_STYLE CRLF)
    if(EXISTS "${path}")
        file(SHA256 "${path}" previous_hash)
        file(SHA256 "${path}.partial" next_hash)
        if(previous_hash STREQUAL next_hash)
            file(REMOVE "${path}.partial")
            return()
        endif()
    endif()
    file(RENAME "${path}.partial" "${path}")
endfunction()

function(copy_runtime source destination)
    if(NOT EXISTS "${source}" OR IS_SYMLINK "${destination}")
        message(FATAL_ERROR "Runtime dependency is missing or destination is a symlink: ${source}")
    endif()
    get_filename_component(parent "${destination}" DIRECTORY)
    file(REAL_PATH "${parent}" resolved_parent)
    cmake_path(IS_PREFIX JAM2_PACKAGE_RELEASE "${resolved_parent}" NORMALIZE confined)
    if(NOT confined)
        message(FATAL_ERROR "Runtime destination escaped the release folder: ${destination}")
    endif()
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${source}" "${destination}" ONLY_IF_DIFFERENT)
endfunction()

if(JAM2_PACKAGE_PLATFORM STREQUAL "windows")
    foreach(runtime IN LISTS JAM2_PACKAGE_RUNTIME_SOURCES)
        get_filename_component(name "${runtime}" NAME)
        copy_runtime("${runtime}" "${JAM2_PACKAGE_RELEASE}/${name}")
    endforeach()
    copy_runtime("${JAM2_PACKAGE_TLS_SOURCE}" "${JAM2_PACKAGE_RELEASE}/tls/qschannelbackend.dll")
    set(executable "${JAM2_PACKAGE_RELEASE}/jam2.exe")
elseif(JAM2_PACKAGE_PLATFORM STREQUAL "macos")
    include("${CMAKE_CURRENT_LIST_DIR}/VerifyMacArchitectures.cmake")
    set(bundle "${JAM2_PACKAGE_RELEASE}/Jam2.app")
    set(executable "${bundle}/Contents/MacOS/jam2")
    if(NOT JAM2_SIGN_IDENTITY)
        set(JAM2_SIGN_IDENTITY "-")
        message(STATUS "macOS local test package: ad-hoc signing, without Developer ID or notarization")
    endif()
    if(NOT EXISTS "${JAM2_PACKAGE_QT_BIN}/macdeployqt")
        message(FATAL_ERROR "The existing Qt installation must provide macdeployqt for a self-contained Mac bundle")
    endif()
    execute_process(COMMAND "${JAM2_PACKAGE_QT_BIN}/macdeployqt" "${bundle}"
        -always-overwrite -no-strip -no-codesign
        "-executable=${bundle}/Contents/Helpers/jamtaster-worker"
        "-executable=${bundle}/Contents/Helpers/jam2-plugin-worker"
        COMMAND_ERROR_IS_FATAL ANY)
    file(GLOB_RECURSE bundle_files LIST_DIRECTORIES FALSE "${bundle}/*")
    set(sign_targets "")
    foreach(binary IN LISTS bundle_files)
        execute_process(COMMAND /usr/bin/file -b "${binary}" OUTPUT_VARIABLE kind
            COMMAND_ERROR_IS_FATAL ANY)
        if(kind MATCHES "Mach-O")
            jam2_require_universal_macos("${binary}")
            if(binary MATCHES "^(.+\\.framework)/")
                # Sign the framework bundle, including its resource seal.
                list(APPEND sign_targets "${CMAKE_MATCH_1}")
            elseif(NOT binary STREQUAL executable)
                list(APPEND sign_targets "${binary}")
            endif()
            execute_process(COMMAND /usr/bin/otool -L "${binary}" OUTPUT_VARIABLE dependencies
                COMMAND_ERROR_IS_FATAL ANY)
            string(REPLACE "\n" ";" dependencies "${dependencies}")
            foreach(dependency IN LISTS dependencies)
                if(dependency MATCHES "^[ \t]+(/[^\t]+) \\(")
                    set(location "${CMAKE_MATCH_1}")
                    if(NOT location MATCHES "^(/System/Library/|/usr/lib/)")
                        message(FATAL_ERROR "Nonportable Mac dependency in ${binary}: ${location}")
                    endif()
                endif()
            endforeach()
        endif()
    endforeach()
    # Qt deployment does not sign our Contents/Helpers executables. Sign all
    # nested code after deployment has finished rewriting library paths, then
    # sign the enclosing app. Descending paths put nested bundles first.
    list(REMOVE_DUPLICATES sign_targets)
    list(SORT sign_targets ORDER DESCENDING)
    foreach(sign_target IN LISTS sign_targets)
        execute_process(COMMAND /usr/bin/codesign --force --sign "${JAM2_SIGN_IDENTITY}" "${sign_target}"
            COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
    execute_process(COMMAND /usr/bin/codesign --force --sign "${JAM2_SIGN_IDENTITY}" "${bundle}"
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND /usr/bin/codesign --verify --deep --strict "${bundle}"
        COMMAND_ERROR_IS_FATAL ANY)
else()
    message(FATAL_ERROR "Unsupported release platform: ${JAM2_PACKAGE_PLATFORM}")
endif()

# Ask the actual public executable; never infer its version from an old ZIP.
execute_process(COMMAND "${executable}" --version OUTPUT_VARIABLE compiled_version
    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT compiled_version STREQUAL "Jam2 ${JAM2_PACKAGE_VERSION}")
    message(FATAL_ERROR "Staged binary version mismatch: ${compiled_version}; expected ${JAM2_PACKAGE_VERSION}")
endif()
if(IS_SYMLINK "${JAM2_PACKAGE_RELEASE}/version.txt")
    message(FATAL_ERROR "version.txt must not be a symlink")
endif()
file(WRITE "${JAM2_PACKAGE_RELEASE}/version.txt" "${JAM2_PACKAGE_VERSION}\n")

# Sidecars are small, checked-in build inputs. App builds do not require weights.
set(model_entries "")
set(model_total 0)
set(model_payload "models/MODEL_NOTICES.md")
foreach(model IN LISTS JAM2_PACKAGE_MODEL_NAMES)
    if(NOT model MATCHES "^[a-z0-9_]+\\.onnx$")
        message(FATAL_ERROR "Invalid model filename: ${model}")
    endif()
    set(source "${JAM2_PACKAGE_SOURCE}/app/jamtaster/models/${model}")
    file(READ "${source}.json" sidecar)
    string(JSON declared_model GET "${sidecar}" model)
    string(JSON bytes GET "${sidecar}" bytes)
    string(JSON hash GET "${sidecar}" sha256)
    string(LENGTH "${hash}" hash_length)
    if(NOT declared_model STREQUAL model OR NOT bytes MATCHES "^[1-9][0-9]*$"
            OR NOT hash MATCHES "^[0-9a-f]+$" OR NOT hash_length EQUAL 64)
        message(FATAL_ERROR "Invalid model metadata: ${source}.json")
    endif()
    if(model_entries)
        string(APPEND model_entries ",\n")
    endif()
    string(APPEND model_entries "    {\"path\":\"${model}\",\"bytes\":${bytes},\"sha256\":\"${hash}\"}")
    math(EXPR model_total "${model_total} + ${bytes}")
    if(JAM2_INCLUDE_MODELS)
        if(NOT EXISTS "${source}")
            message(FATAL_ERROR "Model weights are missing; fetch Git LFS files before using --include-models: ${model}")
        endif()
        file(SIZE "${source}" actual_bytes)
        if(NOT actual_bytes EQUAL bytes)
            message(FATAL_ERROR "Model size mismatch (possibly an LFS pointer): ${model}")
        endif()
        file(SHA256 "${source}" actual_hash)
        if(NOT actual_hash STREQUAL hash)
            message(FATAL_ERROR "Model hash mismatch: ${model}")
        endif()
        copy_runtime("${source}" "${JAM2_PACKAGE_RELEASE}/components/jamtaster/models/${model}")
        copy_runtime("${source}.json" "${JAM2_PACKAGE_RELEASE}/components/jamtaster/models/${model}.json")
        list(APPEND model_payload "models/${model}" "models/${model}.json")
    endif()
endforeach()
string(SHA256 model_identity "${model_entries}")
string(SUBSTRING "${model_identity}" 0 16 model_identity)
set(model_tag "models-${model_identity}")
set(repository_url "https://github.com/PhilKeeble/Jam2/releases/download")
write_json("${JAM2_PACKAGE_RELEASE}/models.json"
    "{\n  \"schema\":1,\n  \"tag\":\"${model_tag}\",\n  \"asset\":\"Jam2-models.zip\",\n  \"archive_root\":\"models/\",\n  \"url\":\"${repository_url}/${model_tag}/Jam2-models.zip\",\n  \"unpacked_bytes\":${model_total},\n  \"files\":[\n${model_entries}\n  ]\n}")
file(SHA256 "${JAM2_PACKAGE_RELEASE}/models.json" model_manifest_hash)
list(APPEND JAM2_PACKAGE_APP_FILES version.txt models.json)

set(payload "")
foreach(path IN LISTS JAM2_PACKAGE_APP_FILES)
    if(IS_DIRECTORY "${JAM2_PACKAGE_RELEASE}/${path}")
        file(GLOB_RECURSE children LIST_DIRECTORIES TRUE RELATIVE "${JAM2_PACKAGE_RELEASE}"
            "${JAM2_PACKAGE_RELEASE}/${path}/*")
        foreach(child IN LISTS children)
            if(NOT IS_DIRECTORY "${JAM2_PACKAGE_RELEASE}/${child}" OR
                    IS_SYMLINK "${JAM2_PACKAGE_RELEASE}/${child}")
                list(APPEND payload "${child}")
            endif()
        endforeach()
    else()
        list(APPEND payload "${path}")
    endif()
endforeach()
list(SORT payload)
set(file_entries "")
foreach(path IN LISTS payload)
    set(absolute "${JAM2_PACKAGE_RELEASE}/${path}")
    file(REAL_PATH "${absolute}" resolved)
    cmake_path(IS_PREFIX JAM2_PACKAGE_RELEASE "${resolved}" NORMALIZE confined)
    if(NOT confined OR NOT EXISTS "${absolute}" OR path MATCHES "[\"\r\n]")
        message(FATAL_ERROR "Missing or nonportable package file: ${path}")
    endif()
    if(path MATCHES "\\.onnx$|(^|/)(settings|temp|update|tracks|songs|logs|captures|cache)/")
        message(FATAL_ERROR "Model weights or user data must not enter the application ZIP: ${path}")
    endif()
    if(file_entries)
        string(APPEND file_entries ",\n")
    endif()
    if(IS_SYMLINK "${absolute}")
        file(READ_SYMLINK "${absolute}" link)
        if(link MATCHES "[\"\\\r\n]")
            message(FATAL_ERROR "Unsupported package symlink: ${path}")
        endif()
        string(APPEND file_entries "    {\"path\":\"${path}\",\"link\":\"${link}\"}")
    else()
        file(SIZE "${absolute}" size)
        file(SHA256 "${absolute}" hash)
        string(APPEND file_entries "    {\"path\":\"${path}\",\"bytes\":${size},\"sha256\":\"${hash}\"}")
    endif()
endforeach()
string(REPLACE ";" "\",\"" architectures "${JAM2_PACKAGE_ARCHITECTURES}")
write_json("${JAM2_PACKAGE_RELEASE}/package-manifest.json"
    "{\n  \"schema\":1,\n  \"version\":\"${JAM2_PACKAGE_VERSION}\",\n  \"platform\":\"${JAM2_PACKAGE_PLATFORM}\",\n  \"architectures\":[\"${architectures}\"],\n  \"models_manifest\":\"models.json\",\n  \"files\":[\n${file_entries}\n  ]\n}")
list(APPEND JAM2_PACKAGE_APP_FILES package-manifest.json)

function(make_zip name entries)
    set(destination "${JAM2_PACKAGE_OUTPUT}/${name}")
    set(archive_directory "${JAM2_PACKAGE_RELEASE}")
    if(name STREQUAL "Jam2-models.zip")
        set(archive_directory "${JAM2_PACKAGE_RELEASE}/components/jamtaster")
    endif()
    if(IS_SYMLINK "${destination}" OR IS_SYMLINK "${destination}.partial")
        message(FATAL_ERROR "Archive destination must not be a symlink: ${destination}")
    endif()
    if(name STREQUAL "Jam2-models.zip" AND EXISTS "${destination}" AND
            EXISTS "${destination}.json" AND NOT IS_SYMLINK "${destination}.json")
        file(READ "${destination}.json" cached)
        string(JSON cached_tag ERROR_VARIABLE tag_error GET "${cached}" tag)
        string(JSON cached_manifest ERROR_VARIABLE manifest_error GET "${cached}" models_manifest_sha256)
        string(JSON cached_name ERROR_VARIABLE name_error GET "${cached}" asset)
        string(JSON cached_channel ERROR_VARIABLE channel_error GET "${cached}" channel)
        string(JSON cached_bytes ERROR_VARIABLE size_error GET "${cached}" bytes)
        string(JSON cached_hash ERROR_VARIABLE hash_error GET "${cached}" sha256)
        if(tag_error STREQUAL "NOTFOUND" AND manifest_error STREQUAL "NOTFOUND" AND
                name_error STREQUAL "NOTFOUND" AND channel_error STREQUAL "NOTFOUND" AND
                size_error STREQUAL "NOTFOUND" AND hash_error STREQUAL "NOTFOUND" AND
                cached_tag STREQUAL model_tag AND cached_manifest STREQUAL model_manifest_hash AND
                cached_name STREQUAL name AND cached_channel STREQUAL "models")
            file(SIZE "${destination}" bytes)
            if(bytes EQUAL cached_bytes)
                file(SHA256 "${destination}" hash)
                if(hash STREQUAL cached_hash)
                    # Model identity is independent of the application version.
                    message(STATUS "Reusing unchanged model ZIP: ${destination} (${bytes} bytes, SHA-256 ${hash})")
                    return()
                endif()
            endif()
        endif()
    endif()
    # Explicit input paths keep personal files in release/ out of the archive.
    set(list_file "${JAM2_PACKAGE_OUTPUT}/.${name}.files")
    string(REPLACE ";" "\n" lines "${entries}")
    file(WRITE "${list_file}" "${lines}\n")
    if(JAM2_PACKAGE_PLATFORM STREQUAL "macos" AND name STREQUAL "Jam2-macos.zip")
        # ditto retains Mac bundle permissions, framework links and resource forks.
        set(stage "${JAM2_PACKAGE_OUTPUT}/.macos-package")
        file(REAL_PATH "${stage}" resolved_stage)
        cmake_path(IS_PREFIX JAM2_PACKAGE_OUTPUT "${resolved_stage}" NORMALIZE confined)
        if(NOT confined OR IS_SYMLINK "${stage}")
            message(FATAL_ERROR "Mac packaging stage escaped dist/: ${stage}")
        endif()
        file(REMOVE_RECURSE "${stage}")
        file(MAKE_DIRECTORY "${stage}")
        foreach(path IN LISTS entries)
            execute_process(COMMAND /usr/bin/ditto "${JAM2_PACKAGE_RELEASE}/${path}" "${stage}/${path}"
                COMMAND_ERROR_IS_FATAL ANY)
        endforeach()
        execute_process(COMMAND /usr/bin/ditto -c -k --sequesterRsrc "${stage}" "${destination}.partial"
            COMMAND_ERROR_IS_FATAL ANY)
        file(REMOVE_RECURSE "${stage}")
    else()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${destination}.partial"
            --format=zip "--files-from=${list_file}"
            WORKING_DIRECTORY "${archive_directory}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
    file(RENAME "${destination}.partial" "${destination}")
    file(REMOVE "${list_file}")
    file(SIZE "${destination}" bytes)
    file(SHA256 "${destination}" hash)
    if(name STREQUAL "Jam2-models.zip")
        set(tag "${model_tag}")
        set(channel models)
    else()
        set(tag "v${JAM2_PACKAGE_VERSION}")
        set(channel stable)
    endif()
    write_json("${JAM2_PACKAGE_OUTPUT}/${name}.json"
        "{\"schema\":1,\"channel\":\"${channel}\",\"version\":\"${JAM2_PACKAGE_VERSION}\",\"tag\":\"${tag}\",\"asset\":\"${name}\",\"bytes\":${bytes},\"sha256\":\"${hash}\",\"url\":\"${repository_url}/${tag}/${name}\",\"models_tag\":\"${model_tag}\",\"models_manifest_sha256\":\"${model_manifest_hash}\"}")
    message(STATUS "Ready: ${destination} (${bytes} bytes, SHA-256 ${hash})")
endfunction()

make_zip("Jam2-${JAM2_PACKAGE_PLATFORM}.zip" "${JAM2_PACKAGE_APP_FILES}")
if(JAM2_INCLUDE_MODELS)
    copy_runtime("${JAM2_PACKAGE_SOURCE}/app/jamtaster/MODEL_NOTICES.md"
        "${JAM2_PACKAGE_RELEASE}/components/jamtaster/models/MODEL_NOTICES.md")
    make_zip(Jam2-models.zip "${model_payload}")
endif()
message(STATUS "Application release tag: v${JAM2_PACKAGE_VERSION}; required model release: ${model_tag} (not latest).")
if(NOT JAM2_INCLUDE_MODELS)
    message(STATUS "Model archive was not rebuilt; use --include-models to create the matching model ZIP.")
endif()
message(STATUS "Local packaging complete.")
