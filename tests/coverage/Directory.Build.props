<Project>
  <PropertyGroup>
    <!-- NuGet consumes MSBuildProjectExtensionsPath before the project body. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\build\coverage\tools-obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
